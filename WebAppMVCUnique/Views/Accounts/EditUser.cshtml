@model WebAppMVCUnique.Models.UsersModel
@{
    ViewData["Title"] = "EditUser";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="text-center mb-0">
                        Edit User Form
                    </h3>
                </div>

                <div class="card-body">
                    <form method="post" asp-action="EditUser" asp-controller="Accounts">

                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input type="hidden" asp-for="UserID" />
                            <input type="text"
                                   asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter your name"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email"
                                   asp-for="Email"
                                   class="form-control"
                                   placeholder="Enter your email"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input type="password"
                                   asp-for="Password"
                                   class="form-control"
                                   placeholder="Enter password"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label d-block">
                                Gender
                            </label>

                            <div class="form-check form-check-inline">
                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="Gender"
                                       value="Male"
                                       required />
                                <label class="form-check-label">
                                    Male
                                </label>
                            </div>

                            <div class="form-check form-check-inline">
                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="Gender"
                                       value="Female" />
                                <label class="form-check-label">
                                    Female
                                </label>
                            </div>


                        </div>

                        <button type="submit"
                                class="btn btn-success w-100">
                            Register
                        </button>

                        <button type="reset"
                                class="btn btn-secondary w-100 mt-2">
                            Reset
                        </button>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>


