
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - My MVC App</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Custom CSS -->
    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: #f8f9fa;
        }

        main {
            flex: 1;
        }

        .site-header {
            background: linear-gradient(90deg, #0d6efd, #084298);
            color: white;
            padding: 20px 0;
        }

        .navbar .nav-link {
            color: white;
            margin-right: 10px;
        }

        .navbar .nav-link:hover,
        .navbar .nav-link.active {
            color: #ffc107;
        }

        .site-footer {
            background-color: #212529;
            color: #dee2e6;
            padding: 20px 0;
            margin-top: 30px;
        }
    </style>
</head>

<body>

    <!-- Header -->
    <header class="site-header">
        <div class="container">
            <h1 class="h3 mb-1">My MVC Application</h1>
            <p class="mb-0">Welcome to our website</p>
        </div>
    </header>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">
                MyApp
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Accounts"
                           asp-action="Homepage">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Accounts"
                           asp-action="GetUser">
                            GetUsers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Accounts"
                           asp-action="ValidateMyform">
                            Validate User
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="StateEx"
                           asp-action="Page1">
                            State Management Ex 
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Accounts"
                           asp-action="Logout">
                            Logout
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container py-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container text-center">
            <p class="mb-1">
                &copy; @DateTime.Now.Year My MVC Application
            </p>

            <small>
                All rights reserved.
                | <a asp-controller="Home"
                     asp-action="Privacy"
                     class="text-info text-decoration-none">
                    Privacy Policy
                </a>
            </small>
        </div>
    </footer>

    <!-- Bootstrap 5 JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
